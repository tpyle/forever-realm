[Unit]
Description=WoW Forever (TrinityCore) login server
Requires=mysql.service
After=network.target mysql.service

[Service]
Type=simple
User=wow
Group=wow
# Certificate paths in bnetserver.conf are relative to this directory.
WorkingDirectory=/opt/wow/forever/server/bin
ExecStart=/opt/wow/forever/server/bin/bnetserver -c /opt/wow/forever/server/etc/bnetserver.conf
Restart=on-failure
RestartSec=5
LimitNOFILE=524288
SyslogIdentifier=forever-bnet

[Install]
# mysql.service too: starting MySQL again (after a package upgrade stopped it, and
# with it this unit, through Requires=) starts this unit again.
WantedBy=multi-user.target mysql.service
